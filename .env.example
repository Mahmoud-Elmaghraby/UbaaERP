# PostgreSQL (local dev docker-compose)
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp_dev_password
POSTGRES_DB=erp_platform
POSTGRES_PORT=5434

# MinIO (local dev docker-compose)
MINIO_ROOT_USER=erp_minio
MINIO_ROOT_PASSWORD=erp_minio_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Secrets-at-rest encryption (apps/api/src/shared/crypto/) — AES-256-GCM
# key, 32 raw bytes base64-encoded. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Needed the first time any tenant stores an encrypted secret (e.g. ETA
# e-invoice credentials, see claude/sales-einvoice-spike.md). Not a real
# KMS — see SecretsEncryptionService's class comment for why that's an
# acceptable, explicitly-flagged MVP tradeoff.
SECRETS_ENCRYPTION_KEY=

# --- API runtime configuration (apps/api) ---
# Validated at boot by apps/api/src/shared/config/env.validation.ts —
# see that file for exact requirements. Missing/malformed values fail
# the process immediately with a combined error, rather than failing
# lazily the first time each one is actually used.

# Tenant Postgres connection string (schema-per-tenant — CLAUDE.md §2.3).
# Local docker-compose default shown; adjust host/port/credentials to
# match POSTGRES_* above if you changed them.
DATABASE_URL=postgres://erp:erp_dev_password@localhost:5434/erp_platform

# Signs/verifies access tokens (apps/api/src/shared/auth). Required,
# at least 16 characters — generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=

# Optional — defaults shown are what the code falls back to if unset.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
PORT=3000
NODE_ENV=development

# Comma-separated allowlist of allowed browser origins for CORS, e.g.
#   CORS_ORIGIN=https://app.example.com,https://admin.example.com
# Required when NODE_ENV=production (the server refuses to boot without
# it — see main.ts). Safe to leave unset for local dev: the server then
# reflects whatever origin the request came from, with a console warning.
CORS_ORIGIN=
