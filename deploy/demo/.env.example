# Copy to deploy/demo/.env and fill in. Generate secrets with:  openssl rand -hex 32
DOMAIN=demo.example.com
DB_PASSWORD=
JWT_ACCESS_SECRET=
# 32 random bytes, base64:  openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=
DOCUMENT_SHARE_SECRET=
STORAGE_SIGNING_SECRET=

# Only when another web server (nginx) already owns ports 80/443 — see README:
# SITE_ADDRESS=:80
# WEB_HTTP_BIND=127.0.0.1:8090
# WEB_HTTPS_BIND=127.0.0.1:8453
