{
  "name": "desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test test/desktop.test.js",
    "stage": "node scripts/stage.mjs",
    "package:win": "node scripts/stage.mjs && electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "electron": "^32.1.0",
    "electron-builder": "^25.0.5",
    "typescript": "^5.6.2"
  },
  "description": "ERP Platform — Windows desktop app",
  "author": "TEG"
}
