{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "jest --config jest.config.js",
    "postinstall": "prisma generate",
    "start": "node dist/main.js",
    "start:dev": "ts-node -P tsconfig.json src/main.ts",
    "db:generate": "prisma generate",
    "db:migrate": "ts-node -P tsconfig.json src/database/tenant/migration-runner.service.ts",
    "db:provision": "ts-node -P tsconfig.json src/database/tenant/provisioning.service.ts",
    "db:migrate:retry": "ts-node -P tsconfig.json src/database/tenant/retry-failed-migrations.command.ts",
    "db:seed-owner": "ts-node -P tsconfig.json src/database/tenant/seed-owner.command.ts",
    "db:seed-walk-in-customer": "ts-node -P tsconfig.json src/database/tenant/seed-walk-in-customer.command.ts",
    "db:seed-plans": "ts-node -P tsconfig.json src/database/public/seed-plans.command.ts",
    "test:unit": "jest --config jest.config.js --selectProjects unit",
    "test:integration": "jest --config jest.config.js --selectProjects integration",
    "test:e2e": "jest --config jest.config.js --selectProjects e2e"
  },
  "dependencies": {
    "@erp-platform/contracts": "workspace:*",
    "@erp-platform/shared-kernel": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "kysely": "^0.29.5",
    "minio": "^8.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8",
    "@nestjs/event-emitter": "^2.1.1",
    "eventemitter2": "^6.4.9",
    "@nestjs/throttler": "^5.2.0",
    "helmet": "^7.1.0",
    "cookie-parser": "^1.4.6"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.15",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.13",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.5.4",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "prisma": "^6.19.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "@types/cookie-parser": "^1.4.7"
  }
}
