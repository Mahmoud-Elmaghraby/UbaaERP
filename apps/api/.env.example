# Prisma (public/platform schema — CLAUDE.md §2.2). Same Postgres instance
# and credentials as the root .env.example / docker-compose.yml, just
# expressed as a connection URL for Prisma's CLI and client.
DATABASE_URL="postgresql://erp:erp_dev_password@localhost:5434/erp_platform?schema=public"

# JWT auth (Users & Permissions module — an implementation decision, not
# specified by the master document). Generate real per-environment
# secrets; never reuse this placeholder outside local dev.
JWT_ACCESS_SECRET="replace-with-a-long-random-value"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS="30"
