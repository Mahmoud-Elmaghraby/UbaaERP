# Prisma (public/platform schema — CLAUDE.md §2.2). Same Postgres instance
# and credentials as the root .env.example / docker-compose.yml, just
# expressed as a connection URL for Prisma's CLI and client.
DATABASE_URL="postgresql://erp:erp_dev_password@localhost:5434/erp_platform?schema=public"

# JWT auth (Users & Permissions module — an implementation decision, not
# specified by the master document). Generate real per-environment
# secrets; never reuse this placeholder outside local dev.
JWT_ACCESS_SECRET="replace-with-a-long-random-value"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS="30"

# MinIO (shared Attachments feature, claude/attachments-strategy.md).
# Defaults match docker-compose.yml's own MinIO defaults for local dev;
# generate real per-environment credentials before deploying.
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY="erp_minio"
MINIO_SECRET_KEY="erp_minio_password"
MINIO_ATTACHMENTS_BUCKET="erp-attachments"

# Live exchange rates (Multi-currency Phase 2, claude/multi-currency-
# strategy.md §3.7). frankfurter.dev is free and needs no API key, so
# this only needs overriding for tests or a self-hosted mirror — safe to
# leave unset in every normal environment.
FRANKFURTER_API_BASE_URL="https://api.frankfurter.dev/v2"
